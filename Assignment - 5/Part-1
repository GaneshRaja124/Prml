# 10. SPLIT DATA INTO 80% TRAINING AND 20% TESTING
# ============================================================

def split_data(X, y):

    indices = np.random.permutation(len(X))

    X = X[indices]
    y = y[indices]

    train_size = int(0.8 * len(X))

    X_train = X[:train_size]
    X_test = X[train_size:]

    y_train = y[:train_size]
    y_test = y[train_size:]

    return (
        X_train,
        X_test,
        y_train,
        y_test
    )


# ============================================================
# 11. MLE MEAN ESTIMATION
# ============================================================

def estimate_mean(data):

    return np.mean(data, axis=0)


# ============================================================
# 12. MLE COVARIANCE ESTIMATION
# ============================================================

def estimate_covariance(data, mean):

    difference = data - mean

    covariance = (
        difference.T @ difference
    ) / len(data)

    return covariance


# ============================================================
# 13. ESTIMATE PARAMETERS FOR THREE CLASSES
# ============================================================

def estimate_parameters(X_train, y_train):

    estimated_means = []
    estimated_covariances = []

    for c in range(3):

        class_data = X_train[
            y_train == c
        ]

        mean = estimate_mean(
            class_data
        )

        covariance = estimate_covariance(
            class_data,
            mean
        )

        estimated_means.append(
            mean
        )

        estimated_covariances.append(
            covariance
        )

    return (
        np.array(estimated_means),
        np.array(estimated_covariances)
    )


# ============================================================
# 14. GAUSSIAN PDF
# ============================================================

def gaussian_pdf(
    x,
    mean,
    covariance
):

    d = len(mean)

    determinant = np.linalg.det(
        covariance
    )

    inverse = np.linalg.inv(
        covariance
    )

    difference = x - mean

    exponent = -0.5 * (
        difference.T
        @ inverse
        @ difference
    )

    constant = 1 / np.sqrt(
        ((2 * np.pi) ** d)
        * determinant
    )

    probability = (
        constant
        * np.exp(exponent)
    )

    return probability


# ============================================================
# 15. CLASSIFICATION
# ============================================================

def classify_data(
    X_test,
    estimated_means,
    estimated_covariances
):

    predictions = []

    for x in X_test:

        probabilities = []

        for c in range(3):

            probability = gaussian_pdf(
                x,
                estimated_means[c],
                estimated_covariances[c]
            )

            probabilities.append(
                probability
            )

        predicted_class = np.argmax(
            probabilities
        )

        predictions.append(
            predicted_class
        )

    return np.array(predictions)


# ============================================================
# 16. CONFUSION MATRIX
# ============================================================

def calculate_confusion_matrix(
    y_test,
    y_pred
):

    matrix = np.zeros(
        (3, 3),
        dtype=int
    )

    for actual, predicted in zip(
        y_test,
        y_pred
    ):

        matrix[
            int(actual),
            int(predicted)
        ] += 1

    return matrix


