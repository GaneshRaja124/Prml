            )
        )

        print("Covariance:")
        print(
            np.round(
                estimated_covariances[c],
                4
            )
        )


    # --------------------------------------------------------
    # Classification
    # --------------------------------------------------------

    y_pred = classify_data(
        X_test,
        estimated_means,
        estimated_covariances
    )
    # ============================================================
    # ROC CURVE
    # ============================================================

    roc_scores = get_gaussian_scores(
        X_test,
        estimated_means,
        estimated_covariances
    )

    plot_multiclass_roc(
        y_test,
        roc_scores,
        [0, 1, 2],
        "ROC Curve - " + experiment_name
    )

    # --------------------------------------------------------
    # Accuracy
    # --------------------------------------------------------

    accuracy = (
        np.mean(
            y_pred == y_test
        ) * 100
    )


    # --------------------------------------------------------
    # Confusion matrix
    # --------------------------------------------------------

    matrix = calculate_confusion_matrix(
        y_test,
        y_pred
    )


    print("\nClassification Accuracy:")
    print(
        round(
            accuracy,
            2
        ),
        "%"
    )

    print("\nConfusion Matrix:")
    print(matrix)


    # --------------------------------------------------------
    # Decision boundary grid
    # --------------------------------------------------------

    x_min = X[:, 0].min() - 1
    x_max = X[:, 0].max() + 1

    y_min = X[:, 1].min() - 1
    y_max = X[:, 1].max() + 1


    xx, yy = np.meshgrid(
        np.linspace(
            x_min,
            x_max,
            200
        ),
        np.linspace(
            y_min,
            y_max,
            200
        )
    )


    grid_points = np.c_[
        xx.ravel(),
        yy.ravel()
    ]


    # --------------------------------------------------------
    # Classify grid points
    # --------------------------------------------------------

    grid_predictions = classify_data(
        grid_points,
        estimated_means,
        estimated_covariances
    )


    Z = grid_predictions.reshape(
        xx.shape
    )


    # --------------------------------------------------------
    # Plot decision boundaries + test data
    # --------------------------------------------------------

    plt.figure(figsize=(9, 7))


    # Decision regions
    plt.contourf(
        xx,
        yy,
        Z,
        alpha=0.2
    )


    # Test data
    for c in range(3):

        data = X_test[
            y_test == c
        ]

        plt.scatter(
            data[:, 0],
            data[:, 1],
            s=5,
            label="Class " + str(c + 1)
        )


    plt.xlabel("X")
    plt.ylabel("Y")

    plt.title(
        experiment_name
        + "\nDecision Boundaries and Test Data"
    )

    plt.legend()
    plt.grid()

    plt.show()


    # Return results
    return {
        "name": experiment_name,
        "accuracy": accuracy,
        "confusion_matrix": matrix,
        "means": estimated_means,
        "covariances": estimated_covariances
    }


