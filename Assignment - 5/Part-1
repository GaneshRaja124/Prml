def generate_standard_normal(N):

    x_values = []
    y_values = []

    while len(x_values) < N:

        u1 = random.uniform(-1, 1)
        u2 = random.uniform(-1, 1)

        s = (u1 ** 2) + (u2 ** 2)

        if 0 < s < 1:

            k = m.sqrt((-2 * m.log(s)) / s)

            x = u1 * k
            y = u2 * k

            x_values.append(x)
            y_values.append(y)

    return np.column_stack((x_values, y_values))


# ============================================================
# 3. GENERATE DATA WITH SPECIFIED MEAN AND COVARIANCE
# ============================================================

def generate_class(N, mean, covariance):

    # Generate standard normal data
    data = generate_standard_normal(N)

    # Cholesky decomposition
    L = np.linalg.cholesky(covariance)

    # Transform standard normal data
    data = data @ L.T

    # Add mean
    data = data + mean

    return data


